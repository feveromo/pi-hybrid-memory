{
  "name": "omp-hybrid-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first hybrid JSONL memory and repo-map extension for OMP.",
  "license": "MIT",
  "keywords": [
    "omp-extension",
    "omp",
    "memory",
    "agent-memory",
    "local-first"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feveromo/pi-hybrid-memory.git"
  },
  "bugs": {
    "url": "https://github.com/feveromo/pi-hybrid-memory/issues"
  },
  "homepage": "https://github.com/feveromo/pi-hybrid-memory/tree/oh-my-pi#readme",
  "files": [
    "extensions/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": ["./extensions/hybrid-memory.ts"]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "scripts": {
    "test": "bun scripts/test.mjs && bun scripts/behavior-test.mjs && bun run test:fixture",
    "test:source": "bun scripts/test.mjs",
    "test:fixture": "bun scripts/fixture-test.mjs",
    "validate": "bun run test && bun run smoke:load",
    "smoke:load": "bun scripts/smoke-load.mjs",
    "smoke": "bun scripts/smoke-load.mjs"
  }
}
