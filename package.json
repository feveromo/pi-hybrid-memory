{
  "name": "pi-hybrid-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first hybrid JSONL memory and repo-map extension for Pi.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "agent-memory",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feveromo/pi-hybrid-memory.git"
  },
  "bugs": {
    "url": "https://github.com/feveromo/pi-hybrid-memory/issues"
  },
  "homepage": "https://github.com/feveromo/pi-hybrid-memory#readme",
  "files": [
    "extensions/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./extensions/hybrid-memory.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "typebox": "1.1.38",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "npm run typecheck && node scripts/test.mjs && node scripts/docs-test.mjs && node scripts/security-test.mjs && node scripts/behavior-test.mjs && node scripts/quality-test.mjs && npm run test:fixture && npm run benchmark",
    "test:source": "node scripts/test.mjs",
    "test:docs": "node scripts/docs-test.mjs",
    "test:quality": "node scripts/quality-test.mjs",
    "test:security": "node scripts/security-test.mjs",
    "test:fixture": "node scripts/fixture-test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm test && npm run smoke:load",
    "release:check": "npm run validate && npm audit --audit-level=high && npm pack --dry-run",
    "smoke:load": "node scripts/smoke-load.mjs",
    "smoke": "pi --no-session --no-extensions -e . -p --model openai-codex/gpt-5.4-mini 'Reply exactly: pi-hybrid-memory-ok'"
  }
}
